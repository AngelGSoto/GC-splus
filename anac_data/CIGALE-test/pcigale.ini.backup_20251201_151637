# CIGALE + XSL 2024 – NGC 5128 Globular Clusters
# Librería estelar: X-Shooter Spectral Library (Arentsen+ 2024)
# Ideal para GCs: alta resolución, calibración empírica, bimodalidad limpia
# Generado el 2025-12-01 15:08:00

data_file = gc_splus_cigale_custom.txt
parameters_file =
sed_modules = sfhdelayed, xsl, dustatt_modified_starburst, redshifting
analysis_method = pdf_analysis
cores = 8

# Bandas S-PLUS (7 narrow + 5 broad equivalentes)
bands = F0378, F0378_err, F0395, F0395_err, F0410, F0410_err,         F0430, F0430_err, F0515, F0515_err, F0660, F0660_err,         F0861, F0861_err

additionalerror = 0.05

[sed_modules_params]
  [[sfhdelayed]]
    tau_main = 10, 50, 100, 500          # GCs viejos → τ corto o largo no importa mucho
    age_main = 1000, 3000, 5000, 8000, 10000, 12000, 14000   # hasta 14 Gyr (XSL lo cubre)
    tau_burst = 10
    age_burst = 10
    f_burst = 0.0                        # SIN bursts → GCs son poblaciones simples
    sfr_A = 1.0
    normalise = True

  [[xsl]]
    imf = 1                              # 1 = Chabrier (único disponible en XSL 2024)
    metallicity = 0.0004, 0.001, 0.004, 0.008, 0.019   # Valores EXACTOS de XSL 2024
    separation_age = 10                  # 10 Myr → población joven casi nula en GCs

  [[dustatt_modified_starburst]]
    E_BV_lines = 0.00, 0.01, 0.02, 0.05  # Muy poco polvo en GCs extragalácticos
    E_BV_factor = 0.44                   # Calzetti para líneas
    uv_bump_amplitude = 0.0              # Sin bump 2175 Å (típico en GCs viejos)
    powerlaw_slope = 0.0
    filters = F0660                      # Solo para calibrar polvo con r-band

  [[redshifting]]
    redshift = 0.001825,                 # NGC 5128 – COMA OBLIGATORIA

[analysis_params]
  variables = stellar.m_star, stellar.metallicity, stellar.age_m_star, dust.luminosity
  save_best_sed = True
  save_chi2 = none
  lim_flag = noscaling
  mock_flag = False
  redshift_decimals = 6
  blocks = 1                             # ← crítico (sin espacio!)
