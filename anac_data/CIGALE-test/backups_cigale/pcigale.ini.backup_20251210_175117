# NGC 5128 Globular Clusters – S-PLUS (CIGALE 2022.0)
# Configuración con redshift fijo en módulo redshifting

data_file = gc_splus_cigale_custom.txt

sed_modules = sfhdelayed, xsl, redshifting

analysis_method = pdf_analysis
cores = 5

# Bands - NO incluir 'redshift' aquí
bands = F0378, F0378_err, F0395, F0395_err, F0410, F0410_err, F0430, F0430_err, F0515, F0515_err, F0660, F0660_err, F0861, F0861_err

additionalerror = 0.05

properties = 

[sed_modules_params]
  
  [[sfhdelayed]]
    tau_main = 500.0, 1000.0, 2000.0, 5000.0
    age_main = 5000, 6000, 7000, 8000, 9000, 10000, 11000, 12000, 13000
    tau_burst = 50.0
    age_burst = 20
    f_burst = 0.0
    sfr_A = 1.0
    normalise = True
  
  [[xsl]]
    imf = 1
    metallicity = 0.0004, 0.004, 0.008, 0.02, 0.03
    separation_age = 10
  
  [[redshifting]]
    # ¡IMPORTANTE! Redshift definido aquí porque NO está en el archivo de datos
    redshift = 0.001825

[analysis_params]
  variables = stellar.m_star, stellar.metallicity, stellar.age_m_star
  bands = F0378, F0395, F0410, F0430, F0515, F0660, F0861
  save_best_sed = True
  save_chi2 = none
  lim_flag = noscaling
  mock_flag = False
  redshift_decimals = 6
