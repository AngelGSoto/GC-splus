# NGC 5128 Globular Clusters - S-PLUS + XSL (CIGALE v2022.0)
# CONFIGURACIÓN CORRECTA - Solo metalicidades disponibles en XSL
# Luis A. Gutiérrez Soto - 2025-12-02
    
data_file = gc_splus_cigale_custom.txt
sed_modules = sfhdelayed, xsl, redshifting
analysis_method = pdf_analysis
cores = 12
    
bands = F0378, F0378_err, F0395, F0395_err, F0410, F0410_err, 
        F0430, F0430_err, F0515, F0515_err, F0660, F0660_err, 
        F0861, F0861_err
    
additionalerror = 0.05
    
[sed_modules_params]
  
  [[sfhdelayed]]
    # Valores optimizados para GCs
    tau_main = 100, 250, 500, 1000, 2000, 5000
    # Edades completas para GCs (1-13 Gyr)
    age_main = 1000, 2000, 3000, 4000, 5000, 6000, 
               7000, 8000, 9000, 10000, 11000, 12000, 13000
    f_burst = 0.0
    normalise = True
  
  [[xsl]]
    imf = 1  # Chabrier IMF
    # SOLO metalicidades disponibles en XSL v2022.0
    metallicity = 0.0004, 0.004, 0.008, 0.02, 0.03
    separation_age = 10
  
  [[redshifting]]
    redshift = 0.001825  # NGC 5128
    
[analysis_params]
  variables = stellar.m_star, stellar.metallicity, stellar.age_m_star,
              stellar.metallicity_mw
  bands = F0378, F0395, F0410, F0430, F0515, F0660, F0861
  save_best_sed = True
  lim_flag = noscaling
  redshift_decimals = 6
  blocks = 1
